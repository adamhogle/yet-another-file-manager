# Backend listen address and port are configured in config/yafm.config.yaml.
# See config/yafm.config.example.yaml for available options.

# YAFM_DISABLE_AUTH=1 is a TEST-ONLY flag, honored only by development builds
# (cfg!(debug_assertions); `cargo run` is a debug build). Release builds ignore
# it: the backend refuses to start without the oidc block. Nothing in the code
# reads .env files — this file documents the flag for local development.
