{
  "name": "yet-another-file-manager-dev",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "devcontainer"
  },
  "forwardPorts": [8080, 5173],
  "portsAttributes": {
    "8080": {
      "label": "Rust Backend",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vue Dev Server",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "Vue.volar", "esbenp.prettier-vscode"],
      "settings": {
        "editor.formatOnSave": true,
        "files.eol": "\n"
      }
    }
  },
  "overrideCommand": true,
  "remoteUser": "node",
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}"
}
