{
  "name": "yet-another-file-manager-dev",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "devcontainer"
  },
  "initializeCommand": "bash -lc 'systemctl --user start podman.socket'",
  "mounts": [
    "type=bind,source=${localEnv:XDG_RUNTIME_DIR}/podman/podman.sock,target=/var/run/docker.sock"
  ],
  "containerEnv": {
    "DOCKER_HOST": "unix:///var/run/docker.sock"
  },
  "forwardPorts": [8080, 5173],
  "portsAttributes": {
    "8080": {
      "label": "Rust Backend",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vue Dev Server",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "Vue.volar", "esbenp.prettier-vscode"],
      "settings": {
        "editor.formatOnSave": true,
        "files.eol": "\n"
      }
    }
  },
  "overrideCommand": true,
  "remoteUser": "node"
}
